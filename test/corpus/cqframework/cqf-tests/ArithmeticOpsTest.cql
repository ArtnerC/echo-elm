library ArithmeticOpsTest

define AddIntegers: 2 + 3
define SubtractIntegers: 10 - 4
define MultiplyIntegers: 3 * 7
define DivideIntegers: 10 / 4
define ModuloIntegers: 10 mod 3
define TruncatedDivide: 10 div 3
define NegateInteger: -(5)
define AbsInteger: Abs(-7)

define AddDecimals: 1.5 + 2.5
define MultiplyDecimals: 2.5 * 4.0
define DivideDecimals: 7.5 / 2.5

define PowerOf: 2 ^ 10

define MinInteger: Min({1, 2, 3, -5, 10})
define MaxInteger: Max({1, 2, 3, -5, 10})
define SumInteger: Sum({1, 2, 3, 4, 5})
define AvgInteger: Avg({2, 4, 6, 8, 10})

define Floor3: Floor(3.7)
define Ceiling3: Ceiling(3.2)
define Round3: Round(3.567, 2)
define Truncate3: Truncate(3.9)
define Ln3: Ln(1.0)
define Exp3: Exp(0.0)
define Log3: Log(100.0, 10)
