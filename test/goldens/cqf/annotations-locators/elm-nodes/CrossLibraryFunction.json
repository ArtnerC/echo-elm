          "s": [
            {
              "value": [
                "// Library-qualified function calls must carry libraryName.\n//\n// `H.\"Doubled\"(21)` parses identically to a method invocation — the grammar\n// cannot tell a library qualifier from a receiver — so the qualifier has to be\n// recovered from the include aliases. Without it the call emits a FunctionRef\n// naming a function in the current library, which is a different reference:\n// here \"Doubled\" exists locally too, so the unqualified form silently resolves\n// to the wrong function rather than failing.\nlibrary CrossLibraryFunction version '1.0'"
              ]
            }
          ]
        },
        "type": "Annotation"
      }
    ],
