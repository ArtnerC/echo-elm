              "value": [
                "// Regression fixture for block-comment @tag annotations.\n//\n// CQF has no allowlist of spec-defined tag names: it emits any tag whose name\n// is a valid CQL identifier and silently drops the rest. So @author and\n// @customThing produce tag data while @measure-component and @dotted.name do not.\nlibrary AnnotationTags version '1.0'"
              ]
            }
          ]
        },
        "type": "Annotation"
      }
