          "s": [
            {
              "value": [
                "// Regression fixture for issues/03-cqf-parity-gaps.md B8 / C4.\n//\n// `date from`, `time from` and `timezoneoffset from` are their own ELM unary\n// operators (DateFrom / TimeFrom / TimezoneOffsetFrom). Only the calendar and\n// clock components use DateTimeComponentFrom, and that node is a UnaryExpression\n// so its \"operand\" is a single object rather than an array.\nlibrary DateTimeComponents version '1.0'"
              ]
            }
          ]
        },
        "type": "Annotation"
      }
