      {
        "s": {
          "s": [
            {
              "value": [
                "// Regression fixture for the implicit Date→DateTime conversion of interval bounds.\n//\n// Comparing a DateTime against a Date-bounded interval literal converts each bound\n// rather than the interval as a whole.\n//\n// This fixture is version-divergent: CQF 3.29.0 lowers the promotion through\n// Property(low/high/lowClosed/highClosed) accessors over the source interval plus\n// lowClosedExpression/highClosedExpression, while 4.8.0 folds the converted bounds\n// directly into the promoted Interval. The 4.8.0 form is the golden.\nlibrary IntervalBoundPromotion version '1.0'"
              ]
            }
          ]
        },
        "t": [],
        "type": "Annotation"
      }
    ],
