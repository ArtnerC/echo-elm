        "s": {
          "s": [
            {
              "value": [
                "// Regression fixture for cross-library terminology resolution.\n//\n// Every HEDIS measure library pulls its value sets and codes from a shared\n// terminology library, so a library-qualified reference must resolve to the\n// typed node (ValueSetRef / CodeRef / CodeSystemRef with libraryName) rather\n// than degrading to a Property access on an ExpressionRef. Resolving this\n// requires the include to be loaded, which is why the translate CLI searches\n// the input file's own directory.\nlibrary CrossLibraryTerminology version '1.0'"
              ]
            }
          ]
        },
        "type": "Annotation"
      }
    ],
