      {
        "s": {
          "s": [
            {
              "value": [
                "// Implicit list traversal: navigating `.p` on a list navigates into each\n// element — `Patient.name.family` is a query over Patient.name, flattened when\n// the property is itself a list (`Patient.name.given`). echo-elm took the\n// property of the list itself, a different value. Traversal is on by default in\n// CQF and in echo-elm's modern translate, and off under the measure profile.\nlibrary ListTraversal version '1.0'"
              ]
            }
          ]
        },
        "t": [],
        "type": "Annotation"
      }
    ],
